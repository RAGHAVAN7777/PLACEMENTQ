# Local PlacementIQ server
PLACEMENTIQ_PORT=8787
PLACEMENTIQ_HOST=127.0.0.1
PLACEMENTIQ_DATA_DIR=server/data/runtime

# Ollama is optional until installed. Local practice mode works without it.
# This endpoint stays on this machine. No cloud fallback is implemented.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_RETRIES=1
OLLAMA_MAX_OUTPUT_TOKENS=900
# Optional CPU workaround for a diagnosed CUDA initialization crash. Leave unset
# for normal automatic GPU offloading; changing it requires a backend restart.
# OLLAMA_NUM_GPU=0

# Optional: raises GitHub's unauthenticated rate limit. Never expose this to Vite.
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=15000
# Integrated readiness policy. Snapshot with each assessment; not learned weights.
READINESS_BASELINE_THRESHOLD=50
READINESS_INTERVIEW_THRESHOLD=65
READINESS_BASELINE_WEIGHT=0.4
READINESS_INTERVIEW_WEIGHT=0.6
# Optional Python executable override; defaults to .venv, or system python if .venv is absent.
# PLACEMENTIQ_PYTHON=python
